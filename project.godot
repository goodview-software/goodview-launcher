config_version=5

[application]
config/name="Goodview Launcher"
config/description="Bundle logiciel Goodview : télécharge, met à jour et lance toutes les apps de l'organisation GitHub goodview-software."
run/main_scene="res://boot.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=1100
window/size/viewport_height=720

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
